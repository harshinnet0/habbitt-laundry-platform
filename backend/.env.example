# Environment Mode (production / development)
NODE_ENV=production

# Server Port (Render sets this dynamically)
PORT=5000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/habbitt_laundry?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_production_jwt_secret_key_here

# Frontend Application URL (Used for Production CORS)
FRONTEND_URL=https://your-frontend-app.onrender.com

# ESP32 Device Authentication Secret Key (Passed via X-Device-Key header)
DEVICE_API_KEY=your_production_device_api_key_here
